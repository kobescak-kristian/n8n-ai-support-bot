# Copy to .env (ignored by git) and fill in. Never commit .env.
# n8n API key (owner creates in n8n: Settings > n8n API), used to import and publish Q123 workflows
N8N_API_KEY=
# Test-only values the build session generates (not real accounts)
Q123_WEBHOOK_KEY=
Q123_FORM_USER=
Q123_FORM_PASSWORD=
Q123_WA_TEST_SECRET=
Q123_WA_TEST_TOKEN=
Q123_WA_VERIFY_TOKEN=
# Supabase project URL (Integrations > Data API), e.g. https://xxxx.supabase.co
Q123_SUPABASE_URL=
# WhatsApp API base: the local stand-in for tests
Q123_WA_API_BASE=http://127.0.0.1:8122
