  {
   "id": "b1fca505-b93f-574a-b31f-1b6aa86a466f",
   "name": "Decide agent action",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    780,
    0
   ],
   "parameters": {
    "jsCode": "const b = $('Agent submit').first().json.body || {};\nconst c = String(b.conversation_id || ''), action = String(b.action || ''), text = String(b.text || '').trim();\nconst logRows = $('Conversation log').all().map((i) => i.json).filter((j) => j.conversation_id === c)\n  .sort((a, b) => String(a.ts).localeCompare(String(b.ts)));\nconst last = logRows[logRows.length - 1] || {};\nconst label = ($('Run label').all().map((i) => i.json).filter((j) => j.run_label).sort((a, b) => String(a.at).localeCompare(String(b.at))).pop() || {}).run_label || 'demo';\nconst valid = !!c && logRows.length > 0 && (action === 'close' || (action === 'reply' && !!text));\nreturn [{ json: { valid, conversation_id: c, action, text, channel: last.channel || 'webchat', wa_id: last.wa_id || '',\n  phone_number_id: last.phone_number_id || '', run_label: label,\n  url: `__WA_API_BASE__/v21.0/${last.phone_number_id || 'none'}/messages`,\n  body: { messaging_product: 'whatsapp', to: last.wa_id || '', type: 'text', text: { body: text.slice(0, 4096) } }, timeout_ms: 20000 } }];\n"
   },
   "executeOnce": true
  },
  {
