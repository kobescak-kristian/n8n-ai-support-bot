  {
   "id": "803bfbb7-fd0f-5d55-b7ae-53b62552a9f3",
   "name": "Page",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    520,
    -360
   ],
   "parameters": {
    "jsCode": "const c = String(($json.query || {}).c || '');\nconst esc = (t) => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst msgs = $('Conversation messages').all().map((i) => i.json).filter((j) => j.conversation_id === c)\n  .sort((a, b) => String(a.at).localeCompare(String(b.at)));\nconst html = `<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width\">\n<title>Reply to customer</title><style>body{font:16px system-ui;max-width:640px;margin:24px auto;padding:0 16px}\n.m{padding:8px 12px;margin:6px 0;border-radius:8px;background:#f1f1f1}.bot{background:#e6f0ff}textarea{width:100%;min-height:120px}</style></head>\n<body><h1>Conversation ${esc(c)}</h1>${msgs.map((m) => `<div class=\"m ${m.role}\"><b>${m.role}</b>: ${esc(m.text)}</div>`).join('')}\n<form method=\"post\" action=\"/webhook/q123-agent-submit\"><input type=\"hidden\" name=\"conversation_id\" value=\"${esc(c)}\">\n<textarea name=\"text\" placeholder=\"Your reply to the customer\"></textarea>\n<p><button name=\"action\" value=\"reply\">Send reply</button> <button name=\"action\" value=\"close\">Close: give back to the bot</button></p></form></body></html>`;\nreturn [{ json: { html } }];\n"
   },
   "executeOnce": true
  },
  {
   "id": "f16f9559-627f-5db9-a0eb-ae15089b269f",
   "name": "Show page",
   "type": "n8n-nodes-base.respondToWebhook",
   "typeVersion": 1.4,
   "position": [
    780,
    -360
   ],
   "parameters": {
    "respondWith": "text",
    "responseBody": "={{ $json.html }}",
    "options": {
     "responseCode": 200,
     "responseHeaders": {
      "entries": [
       {
        "name": "Content-Type",
        "value": "text/html; charset=utf-8"
       }
      ]
     }
    }
   }
  },
