  {
   "id": "54ed142f-2c13-558e-a705-96edaa43b541",
   "name": "Conversation messages",
   "type": "n8n-nodes-base.dataTable",
   "typeVersion": 1.1,
   "position": [
    260,
    -360
   ],
   "parameters": {
    "operation": "get",
    "dataTableId": {
     "__rl": true,
     "mode": "name",
     "value": "support_bot_messages"
    },
    "returnAll": true,
    "matchType": "allConditions",
    "filters": {
     "conditions": [
      {
       "keyName": "conversation_id",
       "condition": "eq",
       "keyValue": "={{ String(($('Agent page').first().json.query || {}).c || 'none') }}"
