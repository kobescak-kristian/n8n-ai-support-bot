       "responseFormat": "json"
      }
     }
    },
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth"
   },
   "credentials": {
    "httpHeaderAuth": {
     "id": "__CRED:waToken__",
     "name": "WhatsApp n8n-ai-support-bot (test)"
    }
   },
   "onError": "continueRegularOutput"
  },
  {
   "id": "2eace768-03f8-50bf-900f-1eb21f5b1224",
   "name": "Agent row",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1820,
    0
   ],
   "parameters": {
    "jsCode": "const d = $('Decide agent action').first().json;\nconst wa = (() => { try { return $('Send WhatsApp reply').first().json; } catch (e) { return null; } })();\nconst delivered = d.action === 'close' ? true : d.channel === 'whatsapp' ? !!(wa && wa.statusCode === 200) : true;\nreturn [{ json: { at: new Date().toISOString(), run_label: d.run_label, conversation_id: d.conversation_id, action: d.action,\n  text: d.text, channel: d.channel, delivered, wa_message_id: wa && wa.body && wa.body.messages ? wa.body.messages[0].id : '' } }];\n"
   },
   "executeOnce": true
  },
