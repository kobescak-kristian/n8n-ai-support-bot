   "parameters": {
    "jsCode": "const q = $json.query || {};\nconst ok = q['hub.mode'] === 'subscribe' && q['hub.verify_token'] === '__WA_VERIFY_TOKEN__';\nreturn [{ json: { ok, challenge: ok ? String(q['hub.challenge'] || '') : 'forbidden' } }];\n"
