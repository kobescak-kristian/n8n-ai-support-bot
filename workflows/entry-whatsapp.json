  {
   "id": "aeaf4578-65d5-5d53-b9cc-61e8f9d70106",
   "name": "Verify signature",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    520,
    0
   ],
   "parameters": {
    "jsCode": "const item = $('WhatsApp message').first().json;\nconst header = String((item.headers || {})['x-hub-signature-256'] || '');\nconst sig = String($json.signature || '');\nconst ok = !!sig && header === 'sha256=' + sig;\nconst events = [];\nif (ok) {\n  for (const e of (item.body || {}).entry || []) for (const ch of e.changes || []) {\n    const v = ch.value || {};\n    for (const m of v.messages || []) events.push({ message_id: m.id, wa_id: m.from, phone_number_id: (v.metadata || {}).phone_number_id,\n      type: m.type, text: m.type === 'text' ? String((m.text || {}).body || '') : String(((m[m.type] || {}).caption) || '') });\n  }\n}\nreturn [{ json: { ok, events } }];\n"
   },
   "executeOnce": true
  },
