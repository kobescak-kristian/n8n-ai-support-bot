  {
   "id": "3502a345-e7cd-56a1-a332-df2d683930da",
   "name": "Public articles only",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    260,
    0
   ],
   "parameters": {
    "jsCode": "const arts = ($json.body || {}).articles || [];\nconst pub = arts.filter((a) => a.visibility === 'public');\nreturn [{ json: { chunks: pub.map((a) => ({ content: `${a.title}\\n${a.text}`, metadata: { article_id: a.id, title: a.title,\n  visibility: a.visibility, updated: a.updated, status: a.status || 'current' } })), skipped: arts.length - pub.length,\n  url: 'https://api.openai.com/v1/embeddings', body: { model: 'text-embedding-3-small', input: pub.map((a) => `${a.title}\\n${a.text}`) },\n  timeout_ms: 60000 } }];\n"
   }
  },
  {
   "id": "4d485f53-4de2-58bf-9be3-6f8b6b81642b",
   "name": "Delete request",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    520,
    0
   ],
   "parameters": {
    "jsCode": "return [{ json: { url: '__SUPABASE_URL__/rest/v1/q123_kb_chunks?id=gt.0', body: {}, timeout_ms: 20000 } }];\n"
   }
  },
