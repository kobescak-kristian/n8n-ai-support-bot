   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1560,
    0
   ],
   "parameters": {
    "jsCode": "const c = $('Public articles only').first().json;\nconst e = $('Embed articles').first().json;\nconst data = e && e.statusCode === 200 ? e.body.data : null;\nif (!data || data.length !== c.chunks.length) return [{ json: { ok: false, error: 'embedding failed', url: '', body: [] } }];\nreturn [{ json: { ok: true, url: '__SUPABASE_URL__/rest/v1/q123_kb_chunks',\n  body: c.chunks.map((ch, i) => ({ ...ch, embedding: data[i].embedding })), timeout_ms: 60000 } }];\n"
   }
  },
