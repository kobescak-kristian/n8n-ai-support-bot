   ],
   "parameters": {
    "jsCode": "const c = $('Public articles only').first().json, ins = $('Insert chunks').first().json;\nreturn [{ json: { indexed: ins && ins.statusCode >= 200 && ins.statusCode < 300 ? c.chunks.length : 0, skipped_internal: c.skipped,\n  insert_status: ins ? ins.statusCode : null } }];\n"
   }
